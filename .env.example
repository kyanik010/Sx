# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
# Optional: required for direct OpenSubtitles REST search and file-ID downloads.
# Configure the real value in AI Studio Secrets or your local .env file.
# The value must be a quoted Java string expression for BuildConfig generation.
OPENSUBTITLES_API_KEY=""
